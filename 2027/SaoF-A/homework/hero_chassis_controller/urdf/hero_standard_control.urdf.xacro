<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hero">
  <xacro:arg name="roller_type" default="realistic"/>
  <xacro:include filename="$(find rm_description_for_task)/urdf/hero/chassis.urdf.xacro"/>
  <xacro:chassis roller_type="$(arg roller_type)"/>

  <!-- The supplied hero wrapper requires the unavailable rm_gazebo plugin. -->
  <gazebo>
    <plugin name="hero_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
    </plugin>
  </gazebo>
</robot>
