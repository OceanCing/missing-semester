<?xml version="1.0"?>
<package format="2">
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf</depend>
  <name>hero_chassis_controller</name>
  <version>0.1.0</version>
  <description>ROS Control mecanum chassis controller for RoboMaster Hero.</description>

  <maintainer email="maintainer@example.com">ImTTired</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>control_toolbox</depend>
  <depend>geometry_msgs</depend>
  <depend>realtime_tools</depend>

  <export>
    <controller_interface plugin="${prefix}/hero_chassis_controller_plugins.xml"/>
  </export>
</package>
